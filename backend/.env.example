# ─── LM Studio (OpenAI-compatible local server) ───────────────────────────
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_API_KEY=lm-studio

# Chat / reasoning model driving the agent. Must support tool calling.
#   google/gemma-4-e4b            (loaded in your LM Studio)
#   qwen2.5-coder-7b-instruct-mlx (stronger tool-calling; good alternative)
CHAT_MODEL=google/gemma-4-e4b

# Embedding model (bge-small = 384 dims, what you have loaded)
EMBEDDING_MODEL=text-embedding-bge-small-en-v1.5
EMBEDDING_BATCH_SIZE=64

LMSTUDIO_TIMEOUT=180

# ─── Agent ─────────────────────────────────────────────────────────────────
AGENT_MAX_STEPS=6
AGENT_TEMPERATURE=0.2

# ─── Retrieval ───────────────────────────────────────────────────────────────
CHROMA_DIR=./data/chroma
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
RETRIEVAL_TOP_K=6
RRF_K=60                 # reciprocal-rank-fusion constant

# ─── Web search ──────────────────────────────────────────────────────────────
# Provider is auto-selected: tavily (if key) > searxng (if url) > duckduckgo.
# Force one with WEB_SEARCH_PROVIDER = tavily | searxng | duckduckgo | auto
WEB_SEARCH_PROVIDER=auto
WEB_SEARCH_RESULTS=5
HTTP_TIMEOUT=15
# TAVILY_API_KEY=
# SEARXNG_URL=http://127.0.0.1:8080

# ─── Database (Postgres: document metadata + chat sessions) ──────────────────
# Defaults to the local OS user with trust auth. Add user:pass@ if your server needs it.
DATABASE_URL=postgresql://localhost:5432/agentic_rag

# ─── Uploads / server ────────────────────────────────────────────────────────
MAX_UPLOAD_MB=25
# Comma-separated origins allowed to call the API (the Vite dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
